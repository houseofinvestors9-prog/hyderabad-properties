# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, Cloud SQL, RDS). Required in production.
# Leave unset locally to use the embedded database in ./.data/pglite (zero setup).
DATABASE_URL=""
# DATABASE_POOL_MAX="5"
# PGLITE_DIR="./.data/pglite"

# ---------------------------------------------------------------------------
# Admin review desk (/admin)
# ---------------------------------------------------------------------------
# Comma separated email:password pairs for staff accounts.
ADMIN_USERS="ops@hoinvestors.com:change-me"
# Or one shared password (any email). Defaults to "admin" in development only.
ADMIN_PASSWORD=""
# 16+ random characters. Required in production. Signs the admin session cookie.
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Ingestion worker
# ---------------------------------------------------------------------------
# Bearer token for GET/POST /api/cron/sync-projects. Required in production.
CRON_SECRET=""
# live | simulate. Defaults to live in production, simulate in development.
INGEST_MODE=""
# Optional URL templates used when a project has no page saved under Admin > Sources.
# RERA_PROJECT_URL_TEMPLATE="https://rera.telangana.gov.in/...{reraId}"
# BPASS_PERMIT_URL_TEMPLATE="https://tsbpass.telangana.gov.in/...{permitNo}"
# INGEST_BACKFILL_PDFS="false"   # true = also read PDFs that existed before the first sync
# INGEST_MAX_PDFS_PER_PAGE="8"
# Lake FTL polygons as GeoJSON (or put the file at data/ftl-lakes.geojson)
FTL_GEOJSON_URL=""
# FTL_BUFFER_METERS="30"
# IGR guideline values as CSV "market,rate_per_sqft,source" (or data/igr-guideline-rates.csv)
IGR_RATES_CSV_URL=""
# GEMINI_MODEL="gemini-2.5-flash"
# AI_ANALYZER="rules"   # force the offline rules reader

# ---------------------------------------------------------------------------
# Buyer alerts
# ---------------------------------------------------------------------------
# Public site URL used in alert links.
PUBLIC_SITE_URL="https://hyderabad.properties"
# Any HTTPS endpoint that sends WhatsApp (Gallabox, Wati, Zapier, Make).
# Receives JSON: { to, text, template, projectId, alertId, link }
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""
# WHATSAPP_TEMPLATE_NAME="project_alert"
# Email via Resend
RESEND_API_KEY=""
ALERT_EMAIL_FROM="hyderabad.properties <alerts@hyderabad.properties>"

# ---------------------------------------------------------------------------
# Leads (contact forms, shortlists, "check this project for me" requests)
# ---------------------------------------------------------------------------
# Every lead is stored in the leads table. Set this to also POST it to the CRM.
# House of Investors Lead Engine door for this site (leads land on the HP rota):
#   LEAD_WEBHOOK_URL="https://hoi-lead-flow.base44.app/functions/webhookHP"
# If the Lead Engine secret HP_WEBHOOK_TOKEN is set, put the same value in LEAD_WEBHOOK_TOKEN.
# Body is flat: name, phone, email, message, page, form, utm_* plus hp_* tracing fields.
# Leads without a phone number are stored here but not forwarded. See docs/BACKEND-WORKFLOW.md, step 9.
LEAD_WEBHOOK_URL=""
LEAD_WEBHOOK_TOKEN=""

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# The six made-up sample projects, the pre-watched project and the "Simulate a change" controls.
# On in development, off in production. Set "true" only on a staging site, never on the public one.
# NEXT_PUBLIC_DEMO_DATA="false"
